# ── Прод-окружение «Твой Подход». Скопировать в .env рядом с docker-compose.prod.yml ──
NODE_ENV=production

# Postgres — контейнер, доступен ТОЛЬКО внутри сети compose (на хост порт не публикуется)
POSTGRES_USER=workout
POSTGRES_PASSWORD=ЗАМЕНИ_на_длинный_случайный_пароль
POSTGRES_DB=workout
# host = db (имя сервиса в compose-сети), НЕ localhost
DATABASE_URL=postgres://workout:ЗАМЕНИ_на_длинный_случайный_пароль@db:5432/workout

# Порт приложения на localhost. ОБЯЗАТЕЛЬНО проверь, что свободен:  ss -ltn | grep 8793
APP_PORT=8793

# Telegram-бот (создать в @BotFather — см. DEPLOY.md)
BOT_TOKEN=
BOT_USERNAME=
# Публичный HTTPS-адрес Mini App. Нужен для постоянной кнопки «Открыть приложение» в меню бота.
WEB_APP_URL=https://podhod.itlabs.top
# Разрешённые Telegram-ID через запятую. ПУСТО = пускать всех (для закрытого круга лучше указать ID).
ALLOWLIST=

# Секрет для cron-эндпоинта напоминаний (любая длинная случайная строка: openssl rand -hex 24)
CRON_SECRET=

# Если api.telegram.org заблокирован с сервера (РФ) — relay-адрес (напр. Cloudflare Worker).
# Пусто = ходить напрямую в https://api.telegram.org
TELEGRAM_API_BASE=

# Telegram-ID получателей еженедельного SQL-бэкапа через запятую.
# Это личные chat_id пользователей, которые предварительно запустили бота.
BACKUP_TELEGRAM_IDS=
# Публичный age-ключ для шифрования бэкапа. Приватный ключ хранить ВНЕ сервера.
# Создание пары: age-keygen -o workout-backup-key.txt
BACKUP_AGE_RECIPIENT=

# Получатели аварийных уведомлений и публичный health URL для cron-монитора.
MONITOR_TELEGRAM_IDS=
HEALTHCHECK_URL=https://podhod.itlabs.top/api/health

# AUTH_DEV_USER_ID в проде НЕ задавать (в production dev-обход авторизации всё равно выключен).
