{
  "name": "workout-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "preview": "nuxt preview",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:db": "vitest run --config vitest.config.ts",
    "test:db:watch": "vitest --config vitest.config.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.config.test.ts",
    "import": "tsx scripts/import-xlsx.ts",
    "reset:baseline": "tsx scripts/reset-baseline.ts",
    "import:exercises": "tsx scripts/import-free-exercise-db.ts",
    "normalize": "tsx scripts/normalize-exercises.ts",
    "backfill:weekday": "tsx scripts/backfill-weekday.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/unbounded": "^5.2.8",
    "@pinia/nuxt": "^0.11.3",
    "@telegram-apps/sdk": "^3.11.8",
    "drizzle-orm": "0.45.2",
    "nuxt": "^4.0.0",
    "pinia": "^3.0.4",
    "postgres": "^3.4.4",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.114",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/icon": "^2.2.4",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "dotenv": "^16.4.5",
    "drizzle-kit": "0.31.8",
    "eslint": "^10.7.0",
    "exceljs": "^4.4.0",
    "happy-dom": "^20.10.6",
    "sass": "^1.101.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
